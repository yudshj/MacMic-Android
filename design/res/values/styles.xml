<?xml version="1.0" encoding="utf-8"?>
<!--
  MacMic phone — M3-style text appearances and widget styles built on PLATFORM attrs only.
  Fonts: system "sans-serif" (Roboto / Google Sans on Pixel) with weight via sans-serif-medium;
  tabular figures via fontFeatureSettings="tnum"; logs use system "monospace". No bundled fonts.
-->
<resources>
    <!-- ============================== type scale ============================== -->
    <style name="TextAppearance.MacMic" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.MacMic.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="TextAppearance.MacMic.TitleLarge">
        <item name="android:textSize">@dimen/text_title_l</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.MacMic.TitleMedium">
        <item name="android:textSize">@dimen/text_title_m</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.MacMic.TitleSmall">
        <item name="android:textSize">@dimen/text_title_s</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.MacMic.BodyLarge">
        <item name="android:textSize">@dimen/text_body_l</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="TextAppearance.MacMic.BodyMedium">
        <item name="android:textSize">@dimen/text_body_m</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="TextAppearance.MacMic.BodySmall">
        <item name="android:textSize">@dimen/text_body_s</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>
    <style name="TextAppearance.MacMic.LabelLarge">
        <item name="android:textSize">@dimen/text_label_l</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.MacMic.LabelMedium">
        <item name="android:textSize">@dimen/text_label_m</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="TextAppearance.MacMic.Cta">
        <item name="android:textSize">@dimen/text_cta</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
    <style name="TextAppearance.MacMic.Address">
        <item name="android:textSize">@dimen/text_address</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="TextAppearance.MacMic.Stat">
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.MacMic.Mono">
        <item name="android:textSize">@dimen/text_mono</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/log_text</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <!-- ============================== containers ============================== -->
    <style name="Widget.MacMic" parent="" />
    <style name="Widget.MacMic.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/card_gap</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>
    <!-- set layout_width at the call site (match_parent, or 0dp + weight=1 inside a header row) -->
    <style name="Widget.MacMic.CardTitle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.TitleSmall</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <!-- 56dp list row: [icon] label / value [trailing] -->
    <style name="Widget.MacMic.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>
    <style name="Widget.MacMic.RowIcon">
        <item name="android:layout_width">@dimen/icon_m</item>
        <item name="android:layout_height">@dimen/icon_m</item>
        <item name="android:layout_marginEnd">@dimen/space_l</item>
        <item name="android:tint">@color/on_surface_variant</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.MacMic.RowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.BodySmall</item>
    </style>
    <style name="Widget.MacMic.RowValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.BodyLarge</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Widget.MacMic.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider</item>
        <item name="android:layout_marginStart">40dp</item>
        <item name="android:background">@color/outline_variant</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- stat tile (packets / bytes / uptime) -->
    <style name="Widget.MacMic.StatTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_stat_tile</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
        <item name="android:focusable">true</item>
        <item name="android:screenReaderFocusable">true</item>
    </style>
    <style name="Widget.MacMic.StatLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.LabelMedium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Widget.MacMic.StatValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.Stat</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">14sp</item>
        <item name="android:autoSizeMaxTextSize">@dimen/text_stat</item>
    </style>
    <style name="Widget.MacMic.StatSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_xxs</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.BodySmall</item>
        <item name="android:textColor">@color/outline</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ============================== controls ============================== -->
    <!-- Big primary CTA = clickable LinearLayout (icon + label centred together). -->
    <style name="Widget.MacMic.Cta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/cta_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_cta_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>
    <!-- Text / tonal small button (banner actions). Platform Button with M3 shape. -->
    <style name="Widget.MacMic.Button.Tonal" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.LabelLarge</item>
        <item name="android:textColor">@color/on_secondary_container</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.MacMic.Button.Text" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.LabelLarge</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.MacMic.IconButton">
        <item name="android:layout_width">@dimen/touch_min</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:padding">@dimen/space_m</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:tint">@color/on_surface_variant</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <!-- M3-look switch on the platform Switch: 52x32 track, 16dp/24dp thumb. -->
    <style name="Widget.MacMic.Switch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:thumbTint">@null</item>
        <item name="android:trackTint">@null</item>
        <item name="android:switchMinWidth">@dimen/switch_min_width</item>
        <item name="android:switchPadding">@dimen/space_l</item>
        <item name="android:showText">false</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:background">@null</item>
    </style>

    <!-- state pill -->
    <style name="Widget.MacMic.Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/pill_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:animateLayoutChanges">true</item>
    </style>
    <!-- small outlined chip (lock indicators) -->
    <style name="Widget.MacMic.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:drawablePadding">@dimen/space_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.MacMic.LabelMedium</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
