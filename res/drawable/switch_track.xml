<?xml version="1.0" encoding="utf-8"?>
<!-- M3-look switch track, 52x32dp. <padding> keeps the thumb 4dp inside the track ends. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1F888888" />
            <corners android:radius="16dp" />
            <size android:width="52dp" android:height="32dp" />
            <padding android:left="4dp" android:right="4dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="16dp" />
            <size android:width="52dp" android:height="32dp" />
            <padding android:left="4dp" android:right="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container_highest" />
            <stroke android:width="2dp" android:color="@color/outline" />
            <corners android:radius="16dp" />
            <size android:width="52dp" android:height="32dp" />
            <padding android:left="4dp" android:right="4dp" />
        </shape>
    </item>
</selector>
