<?xml version="1.0" encoding="utf-8"?>
<!-- Big CTA background (@color/primary). Fully rounded; disabled = 12% on_surface. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple_on_primary">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#1F888888" />
                    <corners android:radius="@dimen/radius_full" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary" />
                    <corners android:radius="@dimen/radius_full" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
