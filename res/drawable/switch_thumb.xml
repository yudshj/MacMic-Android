<?xml version="1.0" encoding="utf-8"?>
<!-- M3-look switch thumb: 22x32dp slot (so 2 x 22 + 8 padding = 52dp track),
     centred circle 16dp (off, outline colour) / 22dp (on, on_primary); every layer <= 22dp wide so the
     intrinsic width stays 22dp in both states. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:width="22dp" android:height="32dp">
                <shape android:shape="rectangle"><solid android:color="#00000000" /></shape>
            </item>
            <item android:width="22dp" android:height="22dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@color/on_primary" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="22dp" android:height="32dp">
                <shape android:shape="rectangle"><solid android:color="#00000000" /></shape>
            </item>
            <item android:width="16dp" android:height="16dp" android:gravity="center">
                <shape android:shape="oval"><solid android:color="@color/outline" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
