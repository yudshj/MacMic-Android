<?xml version="1.0" encoding="utf-8"?>
<!--
  MacMic phone — UI strings, ENGLISH fallback (values/). Chinese, the primary language, lives in
  values-zh/strings.xml and is used on any zh-* locale. (Chinese can't live in values/: with a
  device locale list like [zh-CN, en-US] Android would pick values-en over the default.)
  Formatted strings use positional args (%1$s).
  NOTE: app_name supersedes the one-line phone-app/res/values/strings.xml (merge, don't duplicate).
-->
<resources>
    <string name="app_name">MacMic Server</string>
    <string name="app_title">MacMic</string>
    <string name="app_subtitle">Phone microphone server</string>

    <!-- state pill (short, uppercase-free; English code shown to TalkBack via contentDescription) -->
    <string name="state_stopped">Stopped</string>
    <string name="state_waiting">Waiting</string>
    <string name="state_handshaking">Handshaking</string>
    <string name="state_connected">Connected</string>
    <string name="state_streaming">Streaming</string>
    <string name="state_error">Error</string>
    <string name="cd_state_pill">Status: %1$s</string>

    <!-- hero card -->
    <string name="hero_title_stopped">Service is off</string>
    <string name="hero_sub_stopped">Start the mic service below so your Mac can connect to this phone.</string>
    <string name="hero_title_waiting">Waiting for your Mac</string>
    <string name="hero_sub_waiting">Open MacMic on the Mac, choose Wi-Fi and enter the address below, or connect over USB.</string>
    <string name="hero_title_handshaking">Handshaking…</string>
    <string name="hero_sub_handshaking">%1$s connected, waiting for the protocol handshake.</string>
    <string name="hero_title_connected">Connected</string>
    <string name="hero_sub_connected">%1$s is connected, waiting to start streaming.</string>
    <string name="hero_title_streaming">Streaming</string>
    <string name="hero_sub_streaming">Microphone audio is being sent to %1$s as Opus 48 kHz.</string>
    <string name="hero_title_error">Service error</string>
    <string name="hero_sub_error_generic">%1$s</string>
    <string name="hero_title_port_busy">Port 8125 is in use</string>
    <string name="hero_sub_port_busy">Another WO Mic or MacMic server may be running. Close it and tap Retry; the service also retries every 3 s.</string>
    <string name="hero_title_no_permission">Microphone permission needed</string>
    <string name="hero_sub_no_permission">Grant the permission to start the service.</string>

    <!-- primary CTA -->
    <string name="cta_start">Start service</string>
    <string name="cta_stop">Stop service</string>
    <string name="cta_stop_streaming">Stop streaming</string>
    <string name="cta_retry">Retry</string>
    <string name="cta_starting">Starting…</string>
    <string name="cd_cta_start">Start microphone service</string>
    <string name="cd_cta_stop">Stop microphone service</string>

    <!-- connection card -->
    <string name="section_connection">Connection</string>
    <string name="label_address">This phone</string>
    <string name="label_transport">Transport</string>
    <string name="label_peer">Client</string>
    <string name="label_packets">Packets</string>
    <string name="label_bytes">Sent</string>
    <string name="label_uptime">Uptime</string>
    <string name="address_none">No network</string>
    <string name="address_format">%1$s:%2$d</string>
    <string name="address_more">Other interfaces: %1$s</string>
    <string name="usb_hint">USB: adb forward tcp:8125 tcp:8125</string>
    <string name="transport_wifi">Wi-Fi · UDP</string>
    <string name="transport_usb">USB · TCP (ADB)</string>
    <string name="transport_none">—</string>
    <string name="peer_none">Not connected</string>
    <string name="stat_none">—</string>
    <string name="stat_rate">%1$d pkt/s</string>
    <string name="stat_dropped">%1$d dropped</string>
    <string name="stat_bitrate">%1$d kbps</string>
