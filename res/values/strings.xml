    <string name="copied_toast">Copied %1$s</string>
    <string name="cd_copy_address">Copy address %1$s</string>

    <!-- keep-alive card -->
    <string name="section_keepalive">Keep alive</string>
    <string name="keepalive_title">Keeps streaming with the screen locked</string>
    <string name="keepalive_on">Running as a foreground service with a wake lock and low-latency Wi-Fi lock. Stop it any time from the lock-screen notification.</string>
    <string name="keepalive_off">Once started it runs as a foreground service and shows its status in the notification shade.</string>
    <string name="keepalive_battery">If the system kills it, set Settings › Apps › Battery to \"Unrestricted\".</string>
    <string name="keepalive_lock_wake">WakeLock</string>
    <string name="keepalive_lock_wifi">Wi-Fi lock</string>
    <string name="keep_screen_title">Keep screen on</string>
    <string name="keep_screen_desc">Only while this screen is open; uses more battery</string>

    <!-- log card -->
    <string name="section_log">Event log</string>
    <string name="log_empty">No events yet</string>
    <string name="log_copied">Recent events copied</string>
    <string name="cd_copy_log">Copy event log</string>

    <!-- empty / error banners -->
    <string name="banner_perm_title">Microphone permission needed</string>
    <string name="banner_perm_msg">MacMic needs the Microphone permission to capture audio and send it to your Mac.</string>
    <string name="banner_perm_action">Grant</string>
    <string name="banner_perm_denied_msg">Permission was denied permanently. Enable Microphone for MacMic in system settings.</string>
    <string name="banner_perm_settings">Open settings</string>
    <string name="banner_port_title">Port 8125 is in use</string>
    <string name="banner_port_msg">Another WO Mic or MacMic server may be running. Close it, then tap Retry (auto-retries every 3 s).</string>
    <string name="banner_port_action">Retry</string>
    <string name="banner_notif_title">Notifications are off</string>
    <string name="banner_notif_msg">The service still runs, but you won\'t see its status on the lock screen or be able to stop it there.</string>
    <string name="banner_notif_action">Turn on</string>
    <string name="banner_network_title">Not on Wi-Fi</string>
    <string name="banner_network_msg">Wi-Fi mode needs the phone and Mac on the same network. You can use USB instead.</string>
    <string name="banner_stopped_title">Service is off</string>
    <string name="banner_stopped_msg">Your Mac can\'t connect to this phone right now.</string>
    <string name="banner_dismiss">Got it</string>

    <!-- notification -->
    <string name="notif_channel_name">Microphone service</string>
    <string name="notif_channel_desc">Shows the mic server status with a Stop button</string>
    <string name="notif_title_waiting">Waiting for your Mac</string>
    <string name="notif_title_connected">Connected to %1$s</string>
    <string name="notif_title_streaming">Streaming to %1$s</string>
    <string name="notif_title_error">Mic service error</string>
    <string name="notif_text_waiting">%1$s · port 8125</string>
